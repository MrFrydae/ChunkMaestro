    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <Compile Include="../../../tests/ChunkMaestro.PersistenceTests/*.cs" Exclude="../../../tests/ChunkMaestro.PersistenceTests/UnsupportedPlatformTests.cs" />
  </ItemGroup>
</Project>
